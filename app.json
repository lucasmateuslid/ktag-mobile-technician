{
  "expo": {
    "name": "K-Tag Técnicos",
    "slug": "ktag-technician",
    "scheme": "ktagtech",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.ktagfinder.technician",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "NSCameraUsageDescription": "A câmera registra evidências dos checklists e notas fiscais.",
        "NSFaceIDUsageDescription": "A biometria protege o acesso às ordens de serviço."
      }
    },
    "android": {
      "package": "app.ktagfinder.technician",
      "googleServicesFile": "./google-services.json",
      "permissions": ["CAMERA", "USE_BIOMETRIC", "POST_NOTIFICATIONS"]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-local-authentication",
      ["expo-image-picker", { "cameraPermission": "Permita que o K-Tag registre evidências da OS." }],
      "expo-document-picker",
      "expo-notifications"
    ],
    "experiments": { "typedRoutes": true }
  }
}
